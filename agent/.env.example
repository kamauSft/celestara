# Free weak local agent (default) — searches/sales via tools, no paid LLM
AGENT_DEMO_MODE=1
AGENT_LLM_PROVIDER=local
AGENT_PORT=8787

# Optional: free-tier OpenAI-compatible (e.g. Groq) instead of local
# AGENT_LLM_PROVIDER=openai-compatible
# AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
# AGENT_LLM_API_KEY=gsk_...
# AGENT_LLM_MODEL=llama-3.1-8b-instant

# Optional: Anthropic (needs credits)
# AGENT_LLM_PROVIDER=anthropic
# AGENT_ANTHROPIC_API_KEY=sk-ant-...
