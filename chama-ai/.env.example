# Local development uses SQLite. Postgres is for deployment; apply prisma/rls.sql there.
DATABASE_URL="file:./dev.db"

# Show the official SMS code on the login screen. Never enable this in production.
DEMO_OTP_VISIBLE="true"

# Later phases. Names are configurable; leave the key empty until a provider is connected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_REASONING=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
